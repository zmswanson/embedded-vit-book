@book{mlsys2023ondevice_chapter,
  title = {On-Device Learning (Chapter in ML Systems Design)},
  author = {Zhang, Tian and others},
  year = 2023,
  publisher = {Harvard University},
  comment = {1) Explains that traditionally, training is done centrally on big data/cloud and only inference is done on devices. Implies that in most real scenarios, especially for large models, training occurs on servers, not directly on edge devices. 2) Notes that traditionally there is a “clear division” where models are trained in the cloud and then deployed to devices in a static inference-only mode. Early embedded ML systems adhered to this, focusing on low-latency inference of pretrained models on-device. 3) Discusses that on-device learning is typically used for personalization or incremental updates. It emphasizes fine-tuning small parts of the model to user-specific data and mentions growing interest in hardware/software support for such limited ODL tasks. 4) Discusses methods to enable on-device learning under constraints. Mentions reducing stored gradients/optimizer state and only updating a small subset of parameters so that training becomes feasible on limited hardware. Also references mixed precision and sparse update techniques as ways to minimize on-device computation.}
}
