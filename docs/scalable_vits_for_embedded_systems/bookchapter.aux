\@writefile{toc}{\contentsline {paragraph}{Initial TRT Conversion Outcome.}{21}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Architecturally Incompatible Models.}{22}{}\protected@file@percent }
\newlabel{sec:trt-compat-success}{{5.7}{22}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{A Practitioner's Guide to the Fix.}{22}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Opset upgrades and operator decomposition do not help.}{22}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Watch the dynamo exporter on TensorRT~10.x.}{22}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Half-measures at the model level are not enough.}{22}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Post-hoc ONNX graph surgery is fragile.}{22}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Unified native TensorRT inference latency on the Jetson Orin Nano (batch size 1, $96\times 96$ input, MAXN\_SUPER, locked clocks). All sixteen baseline architectures execute as native TRT engines after applying the per-family rewrites of Section~\ref {sec:trt-compat-success} where required. INT8 uses TRT's built-in PTQ calibration and is reported only for the nine originally TRT-compatible models.}}{23}{}\protected@file@percent }
\newlabel{tab:jetson-latency-full}{{6}{23}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{The fix that does work is a per-family module-level rewrite.}{23}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Always verify cosine similarity end-to-end.}{23}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{ONNX Runtime's TensorRT EP is a viable but slower fallback.}{23}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Unified Latency Results.}{23}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Native TensorRT latency on the Jetson Orin Nano for all sixteen baseline models at FP32 (solid) and FP16 (light), batch size 1, $96\times 96$ input, MAXN\_SUPER. Bars are colored by architecture family.}}{24}{}\protected@file@percent }
\newlabel{fig:latency-comparison}{{11}{24}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces TinyFace rank-1 accuracy vs.\ Jetson FP16 latency for all sixteen baselines under the unified native-TRT harness. The dashed line marks the Pareto front of non-dominated configurations.}}{24}{}\protected@file@percent }
\newlabel{fig:pareto}{{12}{24}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Cross-Family Latency Comparison.}{24}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Pareto Analysis.}{24}{}\protected@file@percent }
