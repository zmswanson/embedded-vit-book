\@writefile{toc}{\contentsline {subsection}{\numberline {5.8}Per-Layer Bottleneck Analysis}{25}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Per-layer time breakdown (FP16, Jetson Orin Nano) for DeiT-3, Swin, and ResNet models. Absolute latency is annotated above each bar. Self-attention (red) consumes a larger fraction in Swin models ($27$--$31\%$) than in DeiT-3 ($7$--$12\%$), while FFN and linear layers (blue) dominate DeiT-3 models ($68$--$83\%$).}}{26}{}\protected@file@percent }
\newlabel{fig:layer-breakdown}{{13}{26}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{DeiT-3 is FFN-dominated.}{26}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Swin distributes compute more evenly between attention and FFN.}{26}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{ResNet is conv-dominated.}{26}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Impact of pruning and KD on compute distribution.}{26}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.9}Computational Profile across Resolutions}{27}{}\protected@file@percent }
\newlabel{sec:flops-profile}{{5.9}{27}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{DeiT-3 and Swin are FFN-bound at $96\times 96$.}{27}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{ConvNeXt is dominated by $1\times 1$ pointwise convolutions, not by depthwise.}{27}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Inference cost (GMACs, batch=1, FP32) versus input resolution for all 16 chapter architectures, grouped into per-family panels with a shared y-axis so that cost can be compared directly across families. Linear axes are used so that the super-linear ($\approx H^2$) growth is visible directly as a parabola; per-family panels prevent the four mid-size families from collapsing onto a single curve at the deployment resolutions. Counter: \texttt  {fvcore.nn.FlopCountAnalysis}.}}{28}{}\protected@file@percent }
\newlabel{fig:flops-vs-resolution}{{14}{28}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{PVT v2 and MobileViT v2 are hybrid.}{28}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{ResNet is conv-bound, as expected.}{28}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Per-module GMACs breakdown for the 16 chapter architectures at the $96\times 96$ TinyFace deployment resolution. Bars are normalised so that segments express the share of inference GMACs; absolute totals are annotated at the right edge. ConvNeXt's ``FFN/MLP'' segment is the inverted-bottleneck $1\times 1$ pointwise stack, which the timm implementation registers as \texttt  {nn.Linear}.}}{29}{}\protected@file@percent }
\newlabel{fig:flops-breakdown-96}{{15}{29}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Top-3 per-module GMACs contributors at the $96\times 96$ TinyFace deployment resolution. ``GMACs'' is the total backbone cost at batch=1; percentages give each category's share of that total. ``FFN / MLP'' includes the inverted-bottleneck $1\times 1$ projection stack for ConvNeXt; ``Attn other'' for PVT v2 captures the spatial-reduction projections inside the attention block.}}{29}{}\protected@file@percent }
\newlabel{tab:flops-top-modules-96}{{7}{29}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.10}Summary and Implications for Embedded Deployment}{30}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Overall best results across all experiments. For each architecture, the best pruning+quantization configuration is shown alongside the unpruned baseline. The highest absolute student accuracy is Swin-T + KD ($\alpha {=}0.0$) at 0.616 rank-1; the smallest competitive model is DeiT3-S at 10\% heads, INT8 (21.7\,MB).}}{30}{}\protected@file@percent }
\newlabel{tab:overall-summary}{{8}{30}{}{}{}}
