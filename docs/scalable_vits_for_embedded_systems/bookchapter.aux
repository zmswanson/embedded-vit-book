\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Latency, throughput and 15W slowdown across the three Jetson Orin Nano power modes for the 14-model representative subset (batch=1, $96\times 96$). All engines benchmarked under the unified native TensorRT harness (\texttt  {trtexec --useCudaGraph}); ConvNeXt-T and PVTv2-B2 use the rewritten engines described in Section~\ref {sec:trt-compat-success}. \textit  {Slowdown} is the 15W mean latency divided by the \texttt  {MAXN\_SUPER} mean latency; \textit  {FPS CV} is the coefficient of variation of throughput across the three modes (lower = more power-mode-stable).}}{32}{}\protected@file@percent }
\newlabel{tab:power-modes}{{9}{32}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Mean inference latency (ms, batch=1, $96\times 96$) for the 14-model representative subset across the three Jetson Orin Nano power modes, all under the unified native TRT harness. The 15W mode adds a uniform $20$--$40\%$ latency penalty over \texttt  {MAXN\_SUPER}; 25W is within $2$--$6\%$ of \texttt  {MAXN\_SUPER} for every model, mirroring the modest $\sim $1\,W difference observed via \texttt  {tegrastats}.}}{32}{}\protected@file@percent }
