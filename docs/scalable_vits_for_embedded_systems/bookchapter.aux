\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Baseline Architecture Comparison}{13}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Rank-1 identification rate on the TinyFace test set for all 16 baseline model variants, sorted by performance. On this low-resolution dataset, vision transformers (DeiT-3, Swin) outperform CNNs (ResNet, ConvNeXt) and hybrid architectures.}}{14}{}\protected@file@percent }
\newlabel{fig:baseline-comparison}{{3}{14}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Parameter-Efficient Fine-Tuning with LoRA}{14}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Knowledge Distillation Results}{14}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Model parameter count versus rank-1 identification rate. Student models (circles) range from 17.4M to 87.6M parameters, while teacher models (stars) used for knowledge distillation are substantially larger (CVLFace 114.9M, PETALface 213.8M). The teachers' size and input resolution requirements make them impractical for embedded deployment, motivating the distillation approach studied in Section~\ref {sec:kd-setup}.}}{15}{}\protected@file@percent }
\newlabel{fig:params-vs-accuracy}{{4}{15}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Knowledge distillation results (rank-1) compared to standalone training. \emph  {Best B/L} refers to the better of baseline or LoRA for each model. The best KD result across all teacher configurations is shown. $\Delta $ indicates the change from the best non-KD result to the best KD result. Default $\alpha = 0.7$.}}{15}{}\protected@file@percent }
\newlabel{tab:kd-results}{{2}{15}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Comparison of baseline (full fine-tuning) and LoRA fine-tuning across Swin and DeiT-3 model variants. LoRA improves Swin models but degrades DeiT-3 performance, revealing an architecture-dependent response to parameter-efficient adaptation.}}{16}{}\protected@file@percent }
\newlabel{fig:baseline-vs-lora}{{5}{16}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Cumulative match characteristic (CMC) curves for the top-performing models compared to a ResNet-50 baseline. DeiT3-Base with LoRA achieves the highest identification rates across all ranks.}}{16}{}\protected@file@percent }
\newlabel{fig:cmc-curves}{{6}{16}{}{}{}}
\citation{hinton2015distillation}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Effect of the distillation loss mixing coefficient $\alpha $ on rank-1 identification rate across four student--teacher configurations. The default $\alpha = 0.7$ is suboptimal for all configurations; lower values favoring the KD loss produce the best results.}}{17}{}\protected@file@percent }
\newlabel{fig:alpha-ablation}{{7}{17}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Optimal distillation mixing coefficient $\alpha $ for each configuration. In all cases, the commonly used $\alpha = 0.7$ is suboptimal. The rightmost column shows the improvement from tuning $\alpha $.}}{17}{}\protected@file@percent }
\newlabel{tab:alpha-optimal}{{3}{17}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Distillation Loss Mixing Ablation}{17}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Knowledge distillation impact: comparison of best standalone training, best KD with default $\alpha = 0.7$, and best KD with optimally tuned $\alpha $. Alpha tuning produces substantial improvements for Swin-T and DeiT3-B.}}{18}{}\protected@file@percent }
\newlabel{fig:kd-overview}{{8}{18}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Quantization Results}{18}{}\protected@file@percent }
\newlabel{sec:quant-results}{{5.5}{18}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Post-training quantization results. FP16 conversion is effectively lossless across all models. INT8 dynamic quantization induces rank-1 drops of at most 0.0016 (absolute) and in one case produces a slight improvement ($+$0.0008 rank-1 for DeiT3-B KD).}}{19}{}\protected@file@percent }
\newlabel{tab:quant-results}{{4}{19}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Model size reduction from FP32 through FP16 to INT8 quantization for all TRT-compatible baseline models. Compression ratios (annotated above INT8 bars) are consistent at $3.7$--$3.9\times $ across architectures.}}{19}{}\protected@file@percent }
\newlabel{fig:size-reduction}{{9}{19}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}Structured Pruning Results}{19}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Block dropping consistently outperforms head pruning.}{19}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Structured pruning + INT8 quantization results across four architectures. Rank-1 accuracy and compression ratio are relative to the corresponding unpruned FP32 model. Bold entries \emph  {improve} over the unpruned baseline. $^\dagger $Block dropping improves accuracy, suggesting depth over-parameterization. $^\ddagger $Head pruning on the KD ($\alpha {=}0.0$) checkpoint is catastrophically unstable (see text).}}{20}{}\protected@file@percent }
\newlabel{tab:pruning-results}{{5}{20}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{DeiT3 is more robust to head pruning than Swin.}{20}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{KD-distilled Swin-T is catastrophically sensitive to head pruning.}{20}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Block dropping on Swin-B confirms depth redundancy.}{20}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{INT8 quantization remains stable on pruned models.}{20}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Comparison of pruning methods across all four architectures (FP32). Red dashed lines indicate the unpruned baseline accuracy. Block dropping (removing entire transformer blocks) consistently outperforms head pruning and in three architectures (Swin-T, Swin-B, DeiT3-S at 10\% heads) \emph  {improves} upon the unpruned model, confirming systematic depth over-parameterization on this 96$\times $96 task.}}{21}{}\protected@file@percent }
\newlabel{fig:pruning-method}{{10}{21}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Compression--accuracy trade-off summary.}{21}{}\protected@file@percent }
