SHELL := /bin/bash

ENV_NAME := vit-benchmark
PYTORCH_INDEX := https://download.pytorch.org/whl/cu130
DALI_INDEX := https://pypi.nvidia.com

.PHONY: env create-env install-torch install-pkgs verify clean

# Top-level target: do everything
env: create-env install-torch install-pkgs verify

# Create or update the conda environment from environment.yml
create-env:
	conda env list | grep -q '$(ENV_NAME)' || conda env create -f environment.yml
	conda env update -n $(ENV_NAME) -f environment.yml --prune

# Install PyTorch (cu130) and DALI (CUDA 13.0) FIRST
install-torch:
	conda run -n $(ENV_NAME) pip install --upgrade pip
	conda run -n $(ENV_NAME) pip install --index-url $(PYTORCH_INDEX) \
		torch torchvision torchaudio
	conda run -n $(ENV_NAME) pip install --extra-index-url $(DALI_INDEX) \
		nvidia-dali-cuda130

# Now install everything that depends on torch
install-pkgs:
	conda run -n $(ENV_NAME) pip install \
		lightning \
		lightning-flash \
		torchmetrics \
		timm \
		wandb \
		transformers \
		datasets \
		accelerate \
		huggingface-hub \
		safetensors \
		tokenizers \
		sentencepiece \
		evaluate \
		opencv-python \
		pillow \
		scikit-image \
		scikit-learn \
		numpy \
		scipy \
		matplotlib \
		tqdm \
		jupyterlab \
		ipykernel
verify:
	conda run -n $(ENV_NAME) python -c "import torch, lightning as L; \
print('Torch:', torch.__version__); \
print('Lightning:', L.__version__); \
print('CUDA available:', torch.cuda.is_available()); \
print('GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU only')"

# Remove the environment if you ever want to start over
clean:
	conda env remove -n $(ENV_NAME) || true

